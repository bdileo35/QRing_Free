{
  "folders": [
    {
      "name": "QRing Free",
      "path": "QRing_Free"
    },
    {
      "name": "QRing Call",
      "path": "QRing_Call"
    },
    {
      "name": "QRing Basic",
      "path": "QRing_Basic"
    },
    {
      "name": "QRing Pro",
      "path": "QRing_Pro"
    },
    {
      "name": "Shared",
      "path": "shared"
    }
  ],
  "settings": {
    "typescript.tsdk": "./QRing_Free/node_modules/typescript/lib",
    "files.exclude": {
      "**/node_modules": true,
      "**/.expo": true,
      "**/dist": true,
      "**/.DS_Store": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.expo": true,
      "**/dist": true
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "javascript.preferences.importModuleSpecifier": "non-relative",
    "typescript.preferences.importModuleSpecifier": "non-relative"
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-tslint-plugin"
    ]
  }
} 